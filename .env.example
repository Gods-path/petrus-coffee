# Copy to .env.local and fill in. Never commit real values.
# All server-side only — no NEXT_PUBLIC_ prefix, so none of this ships to the browser.

# Shared secret for the n8n reservation webhook, sent as the x-webhook-secret header.
# Required: /api/reserve returns 500 without it rather than calling the webhook unauthenticated.
N8N_RESERVATION_WEBHOOK_SECRET=

# Optional overrides. Both default to the production n8n endpoints in code.
# N8N_RESERVATION_WEBHOOK_URL=https://petruscoffee.app.n8n.cloud/webhook/make_reservation
# N8N_CHAT_WEBHOOK_URL=
