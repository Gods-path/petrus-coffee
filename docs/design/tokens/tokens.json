{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Petrus Coffee design tokens — DTCG format. Machine-readable source for Style Dictionary / Tokens Studio. Mirrors tokens.css and theme.css. Palette: earthy coffee & natural wood.",
  "color": {
    "$type": "color",
    "espresso": {
      "50":  { "$value": "#f7f1eb" },
      "100": { "$value": "#ebddcf" },
      "200": { "$value": "#d8bfa6" },
      "300": { "$value": "#be9873" },
      "400": { "$value": "#9a6e44" },
      "500": { "$value": "#7a4e2e" },
      "600": { "$value": "#5c3a21" },
      "700": { "$value": "#4a2e19" },
      "800": { "$value": "#38220f" },
      "900": { "$value": "#2e1e14" }
    },
    "cream": {
      "50":  { "$value": "#fbf6ec" },
      "100": { "$value": "#f5ede1" },
      "200": { "$value": "#efe3d2" },
      "300": { "$value": "#e6d5be" },
      "400": { "$value": "#d8c0a0" },
      "500": { "$value": "#c7a87f" }
    },
    "caramel": {
      "300": { "$value": "#ddb877" },
      "400": { "$value": "#ce9f53" },
      "500": { "$value": "#c08a3e" },
      "600": { "$value": "#a5722c" }
    },
    "wood": {
      "400": { "$value": "#be8a63" },
      "500": { "$value": "#a9744f" },
      "600": { "$value": "#8a5d3d" }
    },
    "olive": {
      "500": { "$value": "#6b7a4f" },
      "600": { "$value": "#566540" }
    },
    "ink": {
      "400": { "$value": "#9c8e7e" },
      "500": { "$value": "#7a6a5a" },
      "700": { "$value": "#3b2a1e" },
      "900": { "$value": "#2e1e14" }
    },
    "feedback": {
      "success": { "$value": "#4f7a3f" },
      "warning": { "$value": "#c7902f" },
      "danger":  { "$value": "#b4472e" },
      "info":    { "$value": "#3c7ca6" }
    },
    "semantic": {
      "background":      { "$value": "{color.cream.100}" },
      "surface":         { "$value": "#ffffff" },
      "surface-cream":   { "$value": "{color.cream.50}" },
      "surface-sunken":  { "$value": "{color.cream.200}" },
      "surface-inverse": { "$value": "{color.espresso.900}" },
      "primary":         { "$value": "{color.espresso.600}" },
      "primary-hover":   { "$value": "{color.espresso.700}" },
      "primary-active":  { "$value": "{color.espresso.800}" },
      "primary-subtle":  { "$value": "{color.espresso.100}" },
      "on-primary":      { "$value": "#fdfbf7" },
      "accent":          { "$value": "{color.caramel.500}" },
      "accent-strong":   { "$value": "{color.caramel.600}" },
      "wood":            { "$value": "{color.wood.500}" },
      "leaf":            { "$value": "{color.olive.500}" },
      "heading":         { "$value": "{color.ink.900}" },
      "text":            { "$value": "{color.ink.700}" },
      "text-muted":      { "$value": "{color.ink.500}" },
      "text-subtle":     { "$value": "{color.ink.400}" },
      "text-on-inverse": { "$value": "{color.cream.100}" },
      "link":            { "$value": "{color.espresso.500}" },
      "border":          { "$value": "rgba(46, 30, 20, 0.12)" },
      "border-strong":   { "$value": "rgba(46, 30, 20, 0.20)" },
      "focus-ring":      { "$value": "{color.caramel.600}" }
    }
  },
  "font": {
    "$type": "fontFamily",
    "display": { "$value": ["Fraunces", "Georgia", "serif"] },
    "sans":    { "$value": ["Manrope", "ui-sans-serif", "system-ui", "sans-serif"] },
    "mono":    { "$value": ["ui-monospace", "JetBrains Mono", "monospace"] }
  },
  "fontWeight": {
    "$type": "fontWeight",
    "regular":  { "$value": 400 },
    "medium":   { "$value": 500 },
    "semibold": { "$value": 600 },
    "bold":     { "$value": 700 },
    "black":    { "$value": 900 }
  },
  "fontSize": {
    "$type": "dimension",
    "display-2xl": { "$value": "clamp(3rem, 1.8rem + 6vw, 6.5rem)" },
    "display-xl":  { "$value": "clamp(2.5rem, 1.6rem + 4.5vw, 5rem)" },
    "display-lg":  { "$value": "clamp(2rem, 1.4rem + 3vw, 3.5rem)" },
    "display-md":  { "$value": "clamp(1.6rem, 1.2rem + 2vw, 2.4rem)" },
    "3xl":  { "$value": "1.875rem" },
    "2xl":  { "$value": "1.5rem" },
    "xl":   { "$value": "1.25rem" },
    "lg":   { "$value": "1.125rem" },
    "base": { "$value": "1rem" },
    "sm":   { "$value": "0.875rem" },
    "xs":   { "$value": "0.75rem" },
    "2xs":  { "$value": "0.6875rem" }
  },
  "lineHeight": {
    "$type": "number",
    "display": { "$value": 1.02 },
    "tight":   { "$value": 1.15 },
    "snug":    { "$value": 1.3 },
    "normal":  { "$value": 1.55 },
    "relaxed": { "$value": 1.7 }
  },
  "letterSpacing": {
    "$type": "dimension",
    "display": { "$value": "-0.015em" },
    "tight":   { "$value": "-0.01em" },
    "normal":  { "$value": "0" },
    "wide":    { "$value": "0.04em" },
    "label":   { "$value": "0.16em" }
  },
  "space": {
    "$type": "dimension",
    "0":  { "$value": "0" },
    "1":  { "$value": "0.25rem" },
    "2":  { "$value": "0.5rem" },
    "3":  { "$value": "0.75rem" },
    "4":  { "$value": "1rem" },
    "5":  { "$value": "1.25rem" },
    "6":  { "$value": "1.5rem" },
    "8":  { "$value": "2rem" },
    "10": { "$value": "2.5rem" },
    "12": { "$value": "3rem" },
    "16": { "$value": "4rem" },
    "20": { "$value": "5rem" },
    "24": { "$value": "6rem" }
  },
  "layout": {
    "$type": "dimension",
    "container-max":    { "$value": "1200px" },
    "container-gutter": { "$value": "clamp(1rem, 4vw, 2.5rem)" },
    "section-py":       { "$value": "clamp(3.5rem, 8vw, 7rem)" }
  },
  "radius": {
    "$type": "dimension",
    "sm":   { "$value": "0.5rem" },
    "md":   { "$value": "0.875rem" },
    "lg":   { "$value": "1.25rem" },
    "xl":   { "$value": "1.75rem" },
    "2xl":  { "$value": "2.5rem" },
    "pill": { "$value": "9999px" }
  },
  "shadow": {
    "$type": "shadow",
    "xs": { "$value": { "offsetX": "0", "offsetY": "1px",  "blur": "2px",  "spread": "0", "color": "rgba(46,30,20,0.06)" } },
    "sm": { "$value": { "offsetX": "0", "offsetY": "2px",  "blur": "10px", "spread": "0", "color": "rgba(46,30,20,0.07)" } },
    "md": { "$value": { "offsetX": "0", "offsetY": "10px", "blur": "30px", "spread": "0", "color": "rgba(46,30,20,0.10)" } },
    "lg": { "$value": { "offsetX": "0", "offsetY": "22px", "blur": "55px", "spread": "0", "color": "rgba(46,30,20,0.16)" } }
  },
  "duration": {
    "$type": "duration",
    "fast": { "$value": "150ms" },
    "base": { "$value": "260ms" },
    "slow": { "$value": "420ms" }
  },
  "easing": {
    "$type": "cubicBezier",
    "out":        { "$value": [0.2, 0.8, 0.2, 1] },
    "in-out":     { "$value": [0.4, 0, 0.2, 1] },
    "emphasized": { "$value": [0.2, 0, 0, 1] }
  },
  "zIndex": {
    "$type": "number",
    "base":    { "$value": 0 },
    "raised":  { "$value": 10 },
    "sticky":  { "$value": 100 },
    "overlay": { "$value": 200 },
    "modal":   { "$value": 300 },
    "toast":   { "$value": 400 }
  }
}
